# Never commit game files, executables or build output.
*.exe
*.dll
*.obj
*.lib
*.pdb
*.bsa
*.esm
*.esp
results*.json
/out/
/obj/
__pycache__/

# Private rebuild inputs, intermediates and local reports (prefer outside the checkout).
/rebuild-private/
/rebuild-out/
/local/
*.ilk
*.map
/build/rebuild/
